CORS_ORIGINS=http://localhost:3000

# --- Optional: human-sounding replies from a language model -----------------
# Put your real key in backend/.env (git-ignored) - never in this file, never in code.
# With no key the app still works: open-ended questions get built-in guidance.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai          # openai | anthropic (inferred from whichever key is set)
# LLM_MODEL=                   # optional override (defaults: gpt-4o-mini / claude-haiku-4-5-20251001)
# LLM_BASE_URL=                # optional, for OpenAI-compatible gateways
# LLM_TIMEOUT_SECONDS=20
